# Copy this file to .env (ignored by git) before `docker compose up -d`.
#
# The validator image must be an immutable digest reference. Compose fails when
# the variable is missing, and scripts/compose-preflight.sh rejects tags such as
# :latest.
#
# Verified reference: csaf-validator-service 3.0.5, linux/amd64, resolved
# 2026-11-15. It supports CSAF 2.0 only. Change it only after the review and
# smoke test described in the README.
CSAF_VALIDATOR_IMAGE=ghcr.io/secvisogram/csaf-validator-service@sha256:e09b8a2b7c7715cce3de2144d73789a06df85a3d116ff07229199060f2e6e5db
